{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "badges": {
          "type": "digital_badges",
          "settings": {
            "digital_label": "Digital download",
            "show_type": true
          }
        },
        "value_prop": {
          "type": "value_proposition",
          "settings": {}
        },
        "delivery": {
          "type": "delivery_note",
          "settings": {
            "text": "<p>This is a digital product. Nothing is shipped \u2014 your download link appears on the order confirmation page and is emailed to you after payment. <a href=\"/pages/download-help\">Download help</a></p>"
          }
        },
        "included": {
          "type": "whats_included",
          "settings": {
            "heading": "What's included"
          }
        },
        "specs": {
          "type": "file_specs",
          "settings": {}
        },
        "sample": {
          "type": "sample_download",
          "settings": {
            "label": "Preview free sample pages"
          }
        },
        "tab_faq": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Download & delivery FAQ",
            "icon": "question_mark",
            "content": "<p><strong>When do I get my files?</strong> Right after payment is confirmed, on the confirmation page and by email.</p><p><strong>Which devices work?</strong> PDF files open on phones, tablets and computers with any PDF reader.</p><p><strong>Link not working?</strong> Email us with your order number and we'll resend it.</p>"
          }
        },
        "tab_license": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "License & usage",
            "icon": "clipboard",
            "content": "<p>Your purchase gives you a personal, non-transferable license to use these files. Sharing, reselling or redistributing them is not allowed unless the product description says otherwise.</p><p><a href=\"/pages/license\">Read the full License and Usage Policy</a></p>"
          }
        },
        "tab_refund": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Refunds",
            "icon": "return",
            "content": "<p>If a file is faulty, missing or not as described, we'll fix it, replace it or refund you. <a href=\"/policies/refund-policy\">Refund and Cancellation Policy</a></p>"
          }
        }
      },
      "block_order": [
        "badges",
        "title",
        "value_prop",
        "price",
        "variant_picker",
        "buy_buttons",
        "delivery",
        "specs",
        "sample",
        "description",
        "included",
        "tab_faq",
        "tab_license",
        "tab_refund",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 40,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You May Also Like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 56
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}