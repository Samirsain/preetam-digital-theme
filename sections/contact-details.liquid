{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="ds-section-head">
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="ds-contact" role="list">
      {%- for block in section.blocks -%}
        <li class="ds-contact__item color-{{ section.settings.card_color_scheme }}" {{ block.shopify_attributes }}>
          <span class="ds-icon-badge">{%- render 'digital-icon', icon: block.settings.icon -%}</span>
          <div>
            <p class="ds-contact__label">{{ block.settings.label | escape }}</p>
            <p class="ds-contact__value">
              {%- case block.settings.link_type -%}
                {%- when 'email' -%}
                  <a href="mailto:{{ block.settings.value | strip }}">{{ block.settings.value | escape }}</a>
                {%- when 'phone' -%}
                  <a href="tel:{{ block.settings.value | remove: ' ' | remove: '-' }}">{{ block.settings.value | escape }}</a>
                {%- else -%}
                  {{ block.settings.value | escape | newline_to_br }}
              {%- endcase -%}
            </p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Contact details",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mail", "label": "Email" },
            { "value": "phone", "label": "Phone" },
            { "value": "pin", "label": "Address" },
            { "value": "support", "label": "Support" }
          ],
          "default": "mail"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Email"
        },
        {
          "type": "textarea",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "select",
          "id": "link_type",
          "label": "Link as",
          "options": [
            { "value": "none", "label": "Plain text" },
            { "value": "email", "label": "Email link" },
            { "value": "phone", "label": "Phone link" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact details"
    }
  ]
}
{% endschema %}
