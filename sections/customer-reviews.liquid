{% comment %}
  Customer reviews.
  Only add reviews that real customers actually wrote. When the section has
  no review or app blocks it renders nothing on the live storefront, so an
  empty section never shows invented testimonials.
{% endcomment %}
{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign has_content = false
  if review_blocks.size > 0 or app_blocks.size > 0
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <div class="ds-section-head">
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}
            <p>{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- unless has_content -%}
        <p class="ds-editor-note">
          This section is hidden on your live store until you add a review or a reviews app block. Only add reviews
          written by real customers.
        </p>
      {%- endunless -%}

      {%- if review_blocks.size > 0 -%}
        <ul class="ds-reviews" role="list">
          {%- for block in review_blocks -%}
            <li {{ block.shopify_attributes }}>
              <figure class="ds-review color-{{ section.settings.card_color_scheme }}">
                {%- if block.settings.rating > 0 -%}
                  <div
                    class="ds-review__stars"
                    role="img"
                    aria-label="{{ block.settings.rating }} out of 5 stars"
                  >
                    {%- for i in (1..5) -%}
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="{% if i <= block.settings.rating %}currentColor{% else %}none{% endif %}"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2 6.4 20.2l1.1-6.3L2.9 9.5l6.3-.9z" stroke-linejoin="round"/>
                      </svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <blockquote class="ds-review__quote">{{ block.settings.quote | escape }}</blockquote>
                <figcaption class="ds-review__meta">
                  <strong>{{ block.settings.author | escape }}</strong>
                  {%- if block.settings.product_name != blank -%}
                    · {{ block.settings.product_name | escape }}
                  {%- endif -%}
                </figcaption>
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- for block in app_blocks -%}
        <div class="ds-reviews__app">{% render block %}</div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 9,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add only genuine reviews from real customers, or add a block from a reviews app. The section stays hidden on the live store while it is empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Customers Say"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "info": "Paste the customer's own words."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "info": "Use the name format the customer agreed to, e.g. first name and last initial."
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product purchased"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating (0 hides stars)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews"
    }
  ]
}
{% endschema %}
