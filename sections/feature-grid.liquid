{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ds-section-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="ds-features ds-features--{{ section.settings.columns_desktop }}" role="list">
      {%- for block in section.blocks -%}
        <li class="ds-feature color-{{ section.settings.card_color_scheme }}" {{ block.shopify_attributes }}>
          <span class="ds-icon-badge">{%- render 'digital-icon', icon: block.settings.icon -%}</span>
          {%- if block.settings.title != blank -%}
            <h3 class="ds-feature__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="ds-feature__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Feature grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "zap", "label": "Lightning" },
            { "value": "download", "label": "Download" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" },
            { "value": "support", "label": "Support" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "book", "label": "Book" },
            { "value": "file", "label": "File" },
            { "value": "layout", "label": "Layout" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "briefcase", "label": "Briefcase" },
            { "value": "globe", "label": "Globe" },
            { "value": "device", "label": "Device" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "license", "label": "License" },
            { "value": "check", "label": "Check" }
          ],
          "default": "zap"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [
        { "type": "feature", "settings": { "icon": "zap", "title": "Instant access", "text": "Download your files right after checkout." } },
        { "type": "feature", "settings": { "icon": "sparkle", "title": "Practical resources", "text": "Made to be used, not just read." } },
        { "type": "feature", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Payments are processed through Shopify checkout." } },
        { "type": "feature", "settings": { "icon": "support", "title": "Real support", "text": "Reach us by email or phone if anything goes wrong." } }
      ]
    }
  ]
}
{% endschema %}
