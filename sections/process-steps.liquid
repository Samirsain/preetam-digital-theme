{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ds-section-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="ds-steps" style="--ds-step-count: {{ section.blocks.size | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="ds-step color-{{ section.settings.card_color_scheme }}" {{ block.shopify_attributes }}>
          <div class="ds-step__top">
            <span class="ds-icon-badge">{%- render 'digital-icon', icon: block.settings.icon -%}</span>
            <span class="ds-step__number">
              {{- 'Step ' -}}
              {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
            </span>
          </div>
          <h3 class="ds-step__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="ds-step__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Process steps",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "search", "label": "Search" },
            { "value": "cart", "label": "Cart" },
            { "value": "download", "label": "Download" },
            { "value": "play", "label": "Start" },
            { "value": "mail", "label": "Email" },
            { "value": "check", "label": "Check" }
          ],
          "default": "search"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process steps",
      "blocks": [
        { "type": "step", "settings": { "icon": "search", "title": "Browse", "text": "Find the resource that fits what you are working on." } },
        { "type": "step", "settings": { "icon": "cart", "title": "Purchase", "text": "Check out securely." } },
        { "type": "step", "settings": { "icon": "download", "title": "Download", "text": "Get your files right after payment." } },
        { "type": "step", "settings": { "icon": "play", "title": "Start Using", "text": "Open, print, or edit and put it to work." } }
      ]
    }
  ]
}
{% endschema %}
