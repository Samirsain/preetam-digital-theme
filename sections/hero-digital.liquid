{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="ds-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="ds-hero__grid">
      <div class="ds-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- if section.settings.use_h1 -%}
            <h1 class="ds-hero__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h1>
          {%- else -%}
            <h2 class="ds-hero__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ds-hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div class="ds-hero__buttons">
            {%- if section.settings.button_label_1 != blank -%}
              <a
                {% if section.settings.button_link_1 == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link_1 }}"
                {% endif %}
                class="button button--primary"
              >
                {{- section.settings.button_label_1 | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a
                {% if section.settings.button_link_2 == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link_2 }}"
                {% endif %}
                class="button button--secondary"
              >
                {{- section.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="ds-hero__trust" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'digital-icon', icon: block.settings.icon -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="ds-hero__media{% if section.settings.image != blank %} ds-hero__media--framed{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 990px) 55vw, 100vw',
              widths: '375, 550, 750, 1100, 1400',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          <img
            src="{{ 'pa-hero-mockup.webp' | asset_url }}"
            alt="{{ section.settings.fallback_alt | escape }}"
            width="1400"
            height="1150"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Digital hero",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Instant digital downloads"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Digital Resources to Help You Do More."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h0"
    },
    {
      "type": "checkbox",
      "id": "use_h1",
      "label": "Use as page H1",
      "info": "Keep enabled on the homepage for a correct heading hierarchy.",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover practical e-books, ready-to-use templates, and digital guides designed to save time and simplify your work.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Browse Bestsellers"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the bundled product mockup illustration."
    },
    {
      "type": "text",
      "id": "fallback_alt",
      "label": "Illustration alt text",
      "default": "Illustration of e-books, a PDF guide on a tablet, and a printable planner"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "trust_point",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "zap", "label": "Lightning" },
            { "value": "download", "label": "Download" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" },
            { "value": "support", "label": "Support" },
            { "value": "globe", "label": "Globe" },
            { "value": "check", "label": "Check" }
          ],
          "default": "zap"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Instant download"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Digital hero",
      "blocks": [
        { "type": "trust_point", "settings": { "icon": "zap", "text": "Instant download" } },
        { "type": "trust_point", "settings": { "icon": "lock", "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}
