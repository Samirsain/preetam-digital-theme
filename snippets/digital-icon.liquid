{% comment %}
  Renders a simple outline icon used across the digital-store sections.

  Accepts:
  - icon: {String} Icon name
  - size: {Number} (optional) Pixel size, default 24

  Usage:
  {% render 'digital-icon', icon: 'book' %}
{% endcomment %}
{%- liquid
  assign icon_size = size | default: 24
-%}
<svg
  class="digital-icon digital-icon--{{ icon }}"
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'book' -%}
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/><path d="M8 7h8M8 10.5h6"/>
    {%- when 'file' -%}
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/>
    {%- when 'layout' -%}
      <rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9h18M9 21V9"/>
    {%- when 'calendar' -%}
      <rect x="3" y="4.5" width="18" height="17" rx="2.5"/><path d="M16 2.5v4M8 2.5v4M3 10h18"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/>
    {%- when 'briefcase' -%}
      <rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12.5h18"/>
    {%- when 'checklist' -%}
      <path d="M10 6h10M10 12h10M10 18h10"/><path d="m3.5 6 1.5 1.5L7.5 5M3.5 12 5 13.5 7.5 11M3.5 18 5 19.5 7.5 17"/>
    {%- when 'download' -%}
      <path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
    {%- when 'zap' -%}
      <path d="M13 2 4 14h7l-1 8 9-12h-7z"/>
    {%- when 'shield' -%}
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'support' -%}
      <path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M18 19a2 2 0 0 0 2-2v-3h-3v5zM6 19a2 2 0 0 1-2-2v-3h3v5z"/><path d="M18 19c0 1.5-2 2.5-5 2.5"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m6 6 2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'cart' -%}
      <circle cx="9" cy="20" r="1.25"/><circle cx="18" cy="20" r="1.25"/><path d="M2.5 3h3l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21.5 7H6.4"/>
    {%- when 'play' -%}
      <circle cx="12" cy="12" r="9"/><path d="m10 8.5 5 3.5-5 3.5z"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"/>
    {%- when 'lock' -%}
      <rect x="4" y="10.5" width="16" height="11" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'phone' -%}
      <path d="M21 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 4.2 2 2 0 0 1 3.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L7.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
    {%- when 'pin' -%}
      <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>
    {%- when 'refresh' -%}
      <path d="M3 12a9 9 0 0 1 15.5-6.3L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.3L3 16"/><path d="M3 21v-5h5"/>
    {%- when 'license' -%}
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h7"/><path d="M14 2v6h6v4"/><circle cx="17.5" cy="17" r="3"/><path d="m16 19.6-.5 2.9 2-1 2 1-.5-2.9"/>
    {%- when 'device' -%}
      <rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M11 18h2"/>
    {%- when 'language' -%}
      <path d="M4 5h9M8.5 3v2M6 5c.5 3 2.5 5.5 5.5 7"/><path d="M11 5c-.5 3.5-3 6.5-7 8"/><path d="m13 21 4-9 4 9M14.5 18h5"/>
    {%- when 'pages' -%}
      <path d="M8 3h9a2 2 0 0 1 2 2v12"/><rect x="4" y="7" width="12" height="15" rx="2"/><path d="M7.5 12h5M7.5 15.5h5"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>
  {%- endcase -%}
</svg>
